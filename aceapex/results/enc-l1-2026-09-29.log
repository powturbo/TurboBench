# enc-l1: AX_ENC=l1 (не умолчание; формат тот же, байты архива другие). ace-core, libzstd 1.4.8,
# медиана 3. Механизм: 8K-слотовая голова хеша (pos+epoch 64 KB, без цепочки), окно = блок 1 MB,
# ленивые пробы pos+1/pos+2 и вставка внутри матча (как в main), + без сплющивания смещений,
# только матчи >= 32 B (короче — в литералы, их берёт zstd/rANS литерального потока),
# пропуск литеральных серий 1 + miss>>4. Умолчание: байты -1/-2 == main (cmp silesia/enwik8/chr1);
# ax_ext (длина матча по 8 байт) ускоряет и умолчание на ~10 %, байты те же.
# Энкод 1 нить: размер B, фаза LZ77 s, всего s, MB/s всего
#            main -1                       main -2                       l1 (-1 = -2)
silesia   69 424 963 2.340 2.608  81     69 029 726 3.406 3.697  57    67 198 601 0.545 0.819 259
enwik8    37 938 677 1.394 1.533  65     37 886 213 1.551 1.673  60    35 698 682 0.170 0.334 299
chr1      67 991 414 3.368 3.720  68     68 111 879 3.601 3.908  65    59 413 477 0.273 0.572 444
# скорость l1 к main: silesia x3.2 (-1) / x4.5 (-2); enwik8 x4.6 / x5.0; chr1 x6.5 / x6.8.
# размер l1 к main -2: silesia -2.65 %, enwik8 -5.77 %, chr1 -12.77 % (ratio лучше на всех трёх).
# 8 нитей -2, всего s: silesia 0.789 -> 0.422, enwik8 0.395 -> 0.221, chr1 0.869 -> 0.434.
